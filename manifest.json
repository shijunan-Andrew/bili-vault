{
  "manifest_version": 3,
  "name": "哔哩藏库",
  "version": "4.6.0",
  "description": "把 B 站收藏夹完整搬到本地：可搜索、可筛选、可离线，视频被删了也还在。支持弹幕、字幕、封面的本地归档与失效视频恢复。",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "nativeMessaging", "clipboardWrite"],
  "host_permissions": [
    "https://*.hdslb.com/*",
    "https://api.bilibili.com/*",
    "https://*.bilivideo.com/*",
    "https://*.bilivideo.cn/*",
    "https://*.akamaized.net/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "B站收藏信息归档",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/video/*",
        "https://bilibili.com/video/*",
        "https://m.bilibili.com/video/*"
      ],
      "js": ["i18n.js", "content.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://space.bilibili.com/*/favlist*"
      ],
      "js": ["favorites-import.js"],
      "run_at": "document_idle"
    }
  ]
}
