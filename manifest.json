{
  "manifest_version": 3,
  "name": "B站收藏信息归档",
  "version": "1.2.0",
  "description": "收藏 B 站视频后归档，并可在本地收藏库中管理收藏夹和视频。",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.hdslb.com/*",
    "https://api.bilibili.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "B站收藏信息归档",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/video/*",
        "https://bilibili.com/video/*",
        "https://m.bilibili.com/video/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
